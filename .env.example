# ==============================================================================
# SPORTS UNIVERSITY OF NIGERIA (SUN) CBT EXAMINATION SYSTEM
# Production Environment Variables for Render Deployment (render.com)
# ==============================================================================

# Server Port (Render sets process.env.PORT automatically, defaults to 3000 locally)
PORT=10000

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Google Gemini API Key
# ------------------------------------------------------------------------------
# Required for AI-powered PDF examination question extraction and automatic parsing.
# Get a free key at: https://aistudio.google.com/app/apikey
# If unset, lecturers can still enter questions manually or paste formatted text.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Firebase Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
# NOTE: The application already includes 'firebase-applet-config.json' with the
# active Sports University of Nigeria Firebase Firestore & Authentication settings.
# You only need to define these if you want to override the bundled configuration.
#
# FIREBASE_PROJECT_ID="gen-lang-client-0071022088"
# FIREBASE_API_KEY="AIzaSy..."
# FIREBASE_AUTH_DOMAIN="gen-lang-client-0071022088.firebaseapp.com"
# FIRESTORE_DATABASE_ID="ai-studio-suncbtsportsuniv-dac9c4d7-b341-4c21-a34f-58dd3f1416a0"
# FIREBASE_STORAGE_BUCKET="gen-lang-client-0071022088.firebasestorage.app"
# FIREBASE_MESSAGING_SENDER_ID="1095066920958"
# FIREBASE_APP_ID="1:1095066920958:web:265e2d21920209b40742af"
#
# Client-side Vite equivalents (if overriding frontend build):
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIRESTORE_DATABASE_ID=""
