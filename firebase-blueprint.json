{
  "entities": {
    "Exam": {
      "title": "Exam",
      "description": "An examination created and managed by a lecturer for SUN CBT.",
      "type": "object",
      "properties": {
        "lecturerId": {
          "type": "string",
          "description": "The UID of the lecturer who created the exam."
        },
        "lecturerEmail": {
          "type": "string",
          "description": "The email address of the lecturer."
        },
        "courseCode": {
          "type": "string",
          "description": "The course code, e.g. SPT 101."
        },
        "courseTitle": {
          "type": "string",
          "description": "The official course title."
        },
        "department": {
          "type": "string",
          "description": "Academic department or All Departments."
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration allocated for the exam in minutes."
        },
        "startDate": {
          "type": "string",
          "description": "ISO start timestamp for exam availability window."
        },
        "endDate": {
          "type": "string",
          "description": "ISO end timestamp for exam availability window."
        },
        "instructions": {
          "type": "string",
          "description": "Examination instructions for candidates."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "closed"],
          "description": "Current publication status."
        },
        "questionsCount": {
          "type": "number",
          "description": "Total number of approved questions in the exam."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp."
        }
      },
      "required": [
        "lecturerId",
        "lecturerEmail",
        "courseCode",
        "courseTitle",
        "department",
        "durationMinutes",
        "startDate",
        "endDate",
        "status",
        "questionsCount"
      ]
    },
    "Submission": {
      "title": "Submission",
      "description": "A student examination submission evaluated securely.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "description": "Reference ID of the exam."
        },
        "lecturerId": {
          "type": "string",
          "description": "The lecturer UID owning the exam."
        },
        "lecturerName": {
          "type": "string",
          "description": "The name of the lecturer who prepared the exam."
        },
        "fullName": {
          "type": "string",
          "description": "Student full name."
        },
        "matricNumber": {
          "type": "string",
          "description": "Unique student matriculation number."
        },
        "department": {
          "type": "string",
          "description": "Student department."
        },
        "gender": {
          "type": "string",
          "description": "Student gender (M or F)."
        },
        "courseCode": {
          "type": "string",
          "description": "Exam course code."
        },
        "score": {
          "type": "number",
          "description": "Evaluated score."
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total questions count."
        },
        "percentage": {
          "type": "number",
          "description": "Calculated percentage score."
        },
        "attemptedCount": {
          "type": "number",
          "description": "Count of attempted questions."
        },
        "unansweredCount": {
          "type": "number",
          "description": "Count of unanswered questions."
        },
        "correctCount": {
          "type": "number",
          "description": "Count of correctly answered questions."
        },
        "incorrectCount": {
          "type": "number",
          "description": "Count of incorrectly answered questions."
        },
        "submittedAt": {
          "type": "string",
          "description": "Timestamp when the exam was submitted."
        },
        "submissionReceipt": {
          "type": "string",
          "description": "Unique verification receipt code."
        }
      },
      "required": [
        "examId",
        "lecturerId",
        "fullName",
        "matricNumber",
        "department",
        "courseCode",
        "score",
        "totalQuestions",
        "percentage",
        "submittedAt",
        "submissionReceipt"
      ]
    },
    "ExamSession": {
      "title": "ExamSession",
      "description": "Live student examination session enforcing server-side timer and duplicate prevention.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "description": "The examination ID."
        },
        "matricNumber": {
          "type": "string",
          "description": "Student matriculation number."
        },
        "gender": {
          "type": "string",
          "description": "Student gender (M or F)."
        },
        "startedAt": {
          "type": "string",
          "description": "ISO timestamp when the student started the exam."
        },
        "durationMinutes": {
          "type": "number",
          "description": "Allocated duration."
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "submitted"],
          "description": "Status of the student session."
        }
      },
      "required": [
        "examId",
        "matricNumber",
        "startedAt",
        "durationMinutes",
        "status"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative audit record for sensitive operations such as examination result deletions.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action performed, e.g. DELETE_EXAMINATION_RESULTS."
        },
        "examId": {
          "type": "string",
          "description": "Target examination identifier."
        },
        "courseCode": {
          "type": "string",
          "description": "Course code of target examination."
        },
        "courseTitle": {
          "type": "string",
          "description": "Course title of target examination."
        },
        "performedByEmail": {
          "type": "string",
          "description": "Email of administrator who executed the action."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the event."
        }
      },
      "required": [
        "action",
        "examId",
        "performedByEmail",
        "timestamp"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Physical student examination attendance record tracking sign-in and sign-out timestamps independently of result records.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "description": "Unique identifier of the examination."
        },
        "courseCode": {
          "type": "string",
          "description": "Course code of the examination."
        },
        "courseTitle": {
          "type": "string",
          "description": "Title of the examination course."
        },
        "matricNumber": {
          "type": "string",
          "description": "Candidate matriculation number (Format A or B)."
        },
        "fullName": {
          "type": "string",
          "description": "Candidate full name in proper title case."
        },
        "department": {
          "type": "string",
          "description": "Candidate academic department."
        },
        "gender": {
          "type": "string",
          "enum": ["M", "F", "Not recorded"],
          "description": "Candidate sex."
        },
        "signInTime": {
          "type": "string",
          "description": "ISO timestamp when the candidate signed into the examination hall."
        },
        "signedInBy": {
          "type": "string",
          "description": "Administrator or invigilator email who recorded sign-in."
        },
        "signOutTime": {
          "type": "string",
          "description": "ISO timestamp when the candidate signed out of the examination hall."
        },
        "signedOutBy": {
          "type": "string",
          "description": "Administrator or invigilator email who recorded sign-out."
        },
        "status": {
          "type": "string",
          "enum": ["absent", "signed_in", "signed_out"],
          "description": "Current physical attendance status."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last attendance update."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of record creation."
        }
      },
      "required": [
        "examId",
        "courseCode",
        "matricNumber",
        "fullName",
        "department",
        "status"
      ]
    }
  },
  "firestore": {
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Stores exam definitions and questions created by lecturers."
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Stores completed student submissions and automated marks."
    },
    "/exam_sessions/{sessionId}": {
      "schema": "ExamSession",
      "description": "Stores active student sessions for timer and duplicate checks."
    },
    "/attendance_records/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Stores student examination physical attendance records (sign-in/sign-out)."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Stores administrative audit entries for security verification."
    },
    "/test/{testId}": {
      "schema": "ExamSession",
      "description": "Health check document path used on boot by getDocFromServer."
    }
  }
}
